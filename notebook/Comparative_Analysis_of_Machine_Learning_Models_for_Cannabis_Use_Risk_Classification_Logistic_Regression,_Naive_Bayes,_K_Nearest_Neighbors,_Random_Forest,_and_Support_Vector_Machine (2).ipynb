        "## Step 7\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import classification_report, accuracy_score, f1_score, roc_auc_score\n",
        "\n",
        "models = {'SVM': svm_model, 'Logistic Regression': lr_model, 'Naive Bayes': nb_model, 'KNN': knn_model, 'Random Forest': rf_model}\n",
        "y_preds = {name: model.predict(X_test_scaled) for name, model in models.items()}\n",
        "train_preds = {name: model.predict(X_train_scaled) for name, model in models.items()}\n",
        "\n",
        "for name, pred in y_preds.items():\n",
        "    print(f'=== {name.upper()} ===\\n', classification_report(y_test, pred, target_names=['Non-User', 'User']))\n",
        "\n",
        "summary_rows = []\n",
        "for name, model in models.items():\n",
        "    test_pred = y_preds[name]\n",
        "    train_pred = train_preds[name]\n",
        "\n",
        "    test_acc = accuracy_score(y_test, test_pred)\n",
        "    test_prec = classification_report(y_test, test_pred, output_dict=True)['1']['precision']\n",
        "    test_rec = classification_report(y_test, test_pred, output_dict=True)['1']['recall']\n",
        "    test_auc = roc_auc_score(y_test, model.predict_proba(X_test_scaled)[:,1])\n",
        "\n",
        "    test_f1 = f1_score(y_test, test_pred, average='weighted')\n",
        "    train_f1 = f1_score(y_train, train_pred, average='weighted')\n",
        "    gap = train_f1 - test_f1\n",
        "\n",
        "    sv = sum(model.n_support_) if name == 'SVM' else \"N/A\"\n",
        "\n",
        "    summary_rows.append({\n",
        "        'Model': name,\n",
        "        'Accuracy': round(test_acc, 4),\n",
        "        'Precision (User)': round(test_prec, 4),\n",
        "        'Recall (User)': round(test_rec, 4),\n",
        "        'AUC-ROC': round(test_auc, 4),\n",
        "        'Train F1': round(train_f1, 4),\n",
        "        'Test F1': round(test_f1, 4),\n",
        "        'F1 Gap': round(gap, 4),\n",
        "        'Support Vectors': sv\n",
        "    })\n",
        "\n",
        "df_summary = pd.DataFrame(summary_rows)\n",
        "df_summary.to_csv(\n",
        "    os.path.join(TABLE_DIR, \"model_performance_summary.csv\"),\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"Performance summary saved!\")\n",
        "print('\\n=== COMPREHENSIVE 5-MODEL RESULTS & OVERFITTING ANALYSIS ===')\n",
        "print(df_summary.to_string(index=False))\n",
        "\n",
        "#Visualization: Train vs Test F1\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "x = np.arange(len(models))\n",
        "width = 0.35\n",
        "\n",
        "ax.bar(x - width/2, df_summary['Train F1'], width, label='Train F1', color='steelblue', edgecolor='black')\n",
        "ax.bar(x + width/2, df_summary['Test F1'], width, label='Test F1', color='coral', edgecolor='black')\n",
        "\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(df_summary['Model'], rotation=15, ha='right')\n",
        "ax.set_ylabel('F1 Score (Weighted)')\n",
        "ax.set_title('Train vs Test Performance (Generalization Gap)', fontweight='bold')\n",
        "ax.legend(loc='lower right')\n",
        "ax.set_ylim(0.70, 1.05)\n",
        "ax.grid(axis='y', alpha=0.3)\n",
        "\n",
        "for container in ax.containers:\n",
        "    ax.bar_label(container, fmt='%.3f', padding=2, fontsize=9)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\n",
        "    os.path.join(FIG_DIR, 'comprehensive_train_test_analysis.png'),\n",
        "    dpi=300,\n",
        "    bbox_inches='tight'\n",
        ")\n",
        "plt.show()"
      ]
    },
