        "## Step 14: Per-Class Performance Comparison\n",
        "\n",
        "from sklearn.metrics import confusion_matrix\n",
        "\n",
        "models = {\n",
        "    'Logistic Regression': lr_model,\n",
        "    'Naive Bayes': nb_model,\n",
        "    'KNN': knn_model,\n",
        "    'Random Forest': rf_model,\n",
        "    'SVM': svm_model\n",
        "}\n",
        "\n",
        "results = []\n",
        "\n",
        "for name, model in models.items():\n",
        "\n",
        "    y_pred = model.predict(X_test_scaled)\n",
        "\n",
        "    tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()\n",
        "\n",
        "    precision_user = tp / (tp + fp)\n",
        "    recall_user = tp / (tp + fn)\n",
        "    f1_user = 2 * (precision_user * recall_user) / (precision_user + recall_user)\n",
        "\n",
        "    precision_nonuser = tn / (tn + fn)\n",
        "    recall_nonuser = tn / (tn + fp)\n",
        "\n",
        "    results.append({\n",
        "        'Model': name,\n",
        "        'User Recall': round(recall_user, 4),\n",
        "        'User Precision': round(precision_user, 4),\n",
        "        'User F1': round(f1_user, 4),\n",
        "        'False Negatives': fn,\n",
        "        'Non-User Recall': round(recall_nonuser, 4)\n",
        "    })\n",
        "\n",
        "per_class_df = pd.DataFrame(results)\n",
        "per_class_df.to_csv(\n",
