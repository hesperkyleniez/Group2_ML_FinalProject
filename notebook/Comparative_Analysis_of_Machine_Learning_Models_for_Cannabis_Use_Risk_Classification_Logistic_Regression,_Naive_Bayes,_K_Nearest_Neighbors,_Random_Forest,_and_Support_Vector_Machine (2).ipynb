      "source": [
        "## Step 15 & 16: Regularization and Complexity Effects (All 5 Models)\n",
        "\n",
        "\n",
        "# --- 1. Train SVM and LR across different C values ---\n",
        "C_values = [0.01, 0.1, 1, 10, 100]\n",
        "svm_f1, lr_f1 = [], []\n",
        "\n",
        "for C in C_values:\n",
        "    # Train SVM\n",
        "    svm_c = SVC(kernel='rbf', C=C, probability=True, random_state=42).fit(X_train_scaled, y_train)\n",
        "    svm_f1.append(f1_score(y_test, svm_c.predict(X_test_scaled), average='weighted'))\n",
        "\n",
        "    # Train LR\n",
        "    lr_c = LogisticRegression(C=C, max_iter=5000, random_state=42).fit(X_train_scaled, y_train)\n",
        "    lr_f1.append(f1_score(y_test, lr_c.predict(X_test_scaled), average='weighted'))\n",
        "\n",
        "# --- 2. Train Naive Bayes across different var_smoothing values ---\n",
        "nb_smoothings = np.logspace(0, -9, num=10)\n",
        "nb_f1 = []\n",
        "\n",
        "for s in nb_smoothings:\n",
        "    # Train NB\n",
        "    nb_s = GaussianNB(var_smoothing=s).fit(X_train_scaled, y_train)\n",
        "    nb_f1.append(f1_score(y_test, nb_s.predict(X_test_scaled), average='weighted'))\n",
        "\n",
        "# --- 3. Train KNN across different n_neighbors values ---\n",
        "knn_neighbors = list(range(1, 102, 2))\n",
        "knn_f1 = []\n",
        "\n",
        "for k in knn_neighbors:\n",
        "    # Train KNN\n",
        "    knn_k = KNeighborsClassifier(n_neighbors=k).fit(X_train_scaled, y_train)\n",
        "    knn_f1.append(f1_score(y_test, knn_k.predict(X_test_scaled), average='weighted'))\n",
        "\n",
        "# --- 4. Train Random Forest across different n_estimators values ---\n",
        "rf_trees = [10, 50, 100, 200, 500]\n",
        "rf_f1 = []\n",
        "\n",
        "for t in rf_trees:\n",
        "    # Train RF\n",
        "    rf_t = RandomForestClassifier(n_estimators=t, random_state=42).fit(X_train_scaled, y_train)\n",
        "    rf_f1.append(f1_score(y_test, rf_t.predict(X_test_scaled), average='weighted'))\n",
        "\n",
        "# --- 5. Plot All Graphs in a 2x2 Layout ---\n",
        "fig, axes = plt.subplots(2, 2, figsize=(18, 12))\n",
        "plt.subplots_adjust(wspace=0.3, hspace=0.4)\n",
        "\n",
        "# Top Left: SVM vs LR (Parameter C)\n",
        "axes[0, 0].plot(C_values, svm_f1, 'bo-', label='SVM', linewidth=2)\n",
        "axes[0, 0].plot(C_values, lr_f1, 'gs-', label='Logistic Regression', linewidth=2)\n",
        "axes[0, 0].set_xscale('log')\n",
        "axes[0, 0].set_xlabel('Regularization Parameter C (log scale)', fontsize=12)\n",
        "axes[0, 0].set_ylabel('F1 Score (Weighted)', fontsize=12)\n",
        "axes[0, 0].set_title('Effect of Regularization (C)', fontweight='bold', fontsize=13)\n",
        "axes[0, 0].legend()\n",
        "axes[0, 0].grid(alpha=0.3)\n",
        "\n",
        "# Top Right: Naive Bayes (var_smoothing)\n",
        "axes[0, 1].plot(nb_smoothings, nb_f1, 'ro-', label='Naive Bayes', linewidth=2)\n",
        "axes[0, 1].set_xscale('log')\n",
        "axes[0, 1].set_xlabel('var_smoothing (log scale)', fontsize=12)\n",
        "axes[0, 1].set_ylabel('F1 Score (Weighted)', fontsize=12)\n",
        "axes[0, 1].set_title('Effect of Smoothing (var_smoothing)', fontweight='bold', fontsize=13)\n",
        "axes[0, 1].legend()\n",
        "axes[0, 1].grid(alpha=0.3)\n",
        "\n",
        "# Bottom Left: KNN (n_neighbors)\n",
        "axes[1, 0].plot(knn_neighbors, knn_f1, 'mo-', label='KNN', linewidth=2)\n",
        "axes[1, 0].set_xlabel('Number of Neighbors (K)', fontsize=12)\n",
        "axes[1, 0].set_ylabel('F1 Score (Weighted)', fontsize=12)\n",
        "axes[1, 0].set_title('Effect of K-Neighbors', fontweight='bold', fontsize=13)\n",
        "axes[1, 0].legend()\n",
        "axes[1, 0].grid(alpha=0.3)\n",
        "\n",
        "# Bottom Right: Random Forest (n_estimators)\n",
        "axes[1, 1].plot(rf_trees, rf_f1, 'ko-', label='Random Forest', linewidth=2)\n",
        "axes[1, 1].set_xlabel('Number of Trees (n_estimators)', fontsize=12)\n",
        "axes[1, 1].set_ylabel('F1 Score (Weighted)', fontsize=12)\n",
        "axes[1, 1].set_title('Effect of Trees', fontweight='bold', fontsize=13)\n",
        "axes[1, 1].legend()\n",
        "axes[1, 1].grid(alpha=0.3)\n",
        "\n",
        "plt.savefig(\n",
        "    os.path.join(FIG_DIR, 'combined_regularization_analysis_5models.png'),\n",
        "    dpi=300,\n",
        "    bbox_inches='tight'\n",
        ")\n",
        "plt.show()\n",
        "\n",
        "print(\"Comparison complete!\")"
      ]
    },
