        "    svm_k.fit(X_train_scaled, y_train)\n",
        "    y_pred_k = svm_k.predict(X_test_scaled)\n",
        "    svm_results.append({\n",
        "        'Kernel': kernel.upper(),\n",
        "        'Accuracy': round(accuracy_score(y_test, y_pred_k), 4),\n",
        "        'F1 (Weighted)': round(f1_score(y_test, y_pred_k, average='weighted'), 4)\n",
        "    })\n",
        "print('\\nSVM KERNEL COMPARISON ')\n",
        "print(pd.DataFrame(svm_results).to_string(index=False))\n",
        "\n",
        "# --- 10.2: LR Solver Comparison ---\n",
        "solvers = ['liblinear', 'lbfgs', 'newton-cg']\n",
        "lr_results = []\n",
        "for solver in solvers:\n",
        "    lr_s = LogisticRegression(solver=solver, C=1.0, max_iter=5000, random_state=42)\n",
        "    lr_s.fit(X_train_scaled, y_train)\n",
        "    y_pred_s = lr_s.predict(X_test_scaled)\n",
