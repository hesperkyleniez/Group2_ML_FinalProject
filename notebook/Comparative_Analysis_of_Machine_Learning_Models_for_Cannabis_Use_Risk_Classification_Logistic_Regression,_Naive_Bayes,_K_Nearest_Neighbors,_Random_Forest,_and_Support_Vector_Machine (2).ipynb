      "source": [
        "## Step 12: Cross-Model Feature Importance Comparison (Corrected)\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def get_mean_shap(shap_values):\n",
        "    \"\"\"\n",
        "    Convert SHAP outputs into mean absolute SHAP importance.\n",
        "    Guarantees a 1D array of shape (n_features,) is returned.\n",
        "    \"\"\"\n",
        "    if hasattr(shap_values, 'values'):\n",
        "        vals = shap_values.values\n",
        "    elif isinstance(shap_values, list):\n",
        "        vals = shap_values[1]\n",
        "    else:\n",
        "        vals = np.array(shap_values)\n",
        "\n",
        "    if vals.ndim == 3:\n",
        "        vals = vals[:, :, 1]\n",
        "\n",
        "    return np.abs(vals).mean(axis=0)\n",
        "\n",
        "\n",
        "def normalize_importance(arr):\n",
        "    return arr / arr.sum()\n",
        "\n",
        "svm_importance = normalize_importance(get_mean_shap(shap_values_svm))\n",
        "lr_importance = normalize_importance(get_mean_shap(shap_values_lr))\n",
        "knn_importance = normalize_importance(get_mean_shap(shap_values_knn))\n",
        "rf_importance = normalize_importance(get_mean_shap(shap_values_rf))\n",
        "nb_importance = normalize_importance(get_mean_shap(shap_values_nb))\n",
        "\n",
        "importance_df = pd.DataFrame({\n",
        "    'Feature': feature_names,\n",
        "    'SVM': svm_importance,\n",
        "    'LR': lr_importance,\n",
        "    'NB': nb_importance,\n",
        "    'KNN': knn_importance,\n",
        "    'RF': rf_importance\n",
        "})\n",
        "\n",
        "importance_df['Average'] = importance_df[['SVM', 'LR', 'NB', 'KNN', 'RF']].mean(axis=1)\n",
        "\n",
        "importance_df = importance_df.sort_values(by='Average', ascending=False)\n",
        "importance_df.to_csv(\n",
        "    os.path.join(TABLE_DIR, \"cross_model_feature_importance.csv\"),\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"Feature importance table saved!\")\n",
        "\n",
        "print('\\n=== Cross-Model Feature Importance ===')\n",
        "print(importance_df.round(4).to_string(index=False))\n",
        "\n",
        "top_features = importance_df.head(10)\n",
        "plt.figure(figsize=(14, 6))\n",
        "top_features.set_index('Feature')[['SVM', 'LR', 'NB', 'KNN', 'RF']].plot(\n",
        "    kind='bar',\n",
        "    figsize=(14, 6),\n",
        "    width=0.8,\n",
        "    colormap='viridis'\n",
        ")\n",
        "\n",
        "plt.title('Cross-Model Feature Importance Comparison (Top 10)', fontweight='bold', fontsize=14, pad=15)\n",
        "plt.ylabel('Mean Absolute SHAP Importance', fontsize=12)\n",
        "plt.xlabel('Feature', fontsize=12)\n",
        "plt.xticks(rotation=45, ha='right', fontsize=11)\n",
        "plt.legend(title='Models')\n",
        "plt.grid(axis='y', alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\n",
        "    os.path.join(FIG_DIR, 'cross_model_feature_importance.png'),\n",
        "    dpi=300,\n",
        "    bbox_inches='tight'\n",
        ")\n",
        "plt.show()"
